{
  "name": "web-testing-agent",
  "version": "1.0.0",
  "description": "AI-powered web testing agent that can test applications based on natural language scenarios",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx src/index.ts",
    "web": "tsx src/server.ts",
    "install-browsers": "playwright install"
  },
  "keywords": [
    "testing",
    "automation",
    "playwright",
    "ai",
    "web-testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "playwright": "^1.48.0",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
